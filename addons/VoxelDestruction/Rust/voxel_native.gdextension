[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.4"
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://addons/VoxelDestruction/Rust/voxel_native/target/debug/libvoxel_native.so"
linux.release.x86_64 =   "res://addons/VoxelDestruction/Rust/voxel_native/target/release/libvoxel_native.so"
windows.debug.x86_64 =   "res://addons/VoxelDestruction/Rust/voxel_native/target/debug/voxel_native.dll"
windows.release.x86_64 = "res://addons/VoxelDestruction/Rust/voxel_native/target/release/voxel_native.dll"
macos.debug =            "res://addons/VoxelDestruction/Rust/voxel_native/target/debug/libvoxel_native.dylib"
macos.release =          "res://addons/VoxelDestruction/Rust/voxel_native/target/release/libvoxel_native.dylib"
macos.debug.arm64 =      "res://addons/VoxelDestruction/Rust/voxel_native/target/debug/libvoxel_native.dylib"
macos.release.arm64 =    "res://addons/VoxelDestruction/Rust/voxel_native/target/release/libvoxel_native.dylib"